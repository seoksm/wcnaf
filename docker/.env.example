# docker/.env 로 복사한 뒤 실제 값을 채워서 사용한다. 이 파일(.env.example) 자체는 git에
# 커밋되지만 .env는 .gitignore로 제외된다 - 실제 값은 절대 커밋하지 않는다.

# Minio(S3 호환 스토리지) 관리자 계정 - 로컬/개발용 docker 컨테이너 전용
ID=devlocal
PW=devlocal

# Kafka advertised listener 주소 (보통 localhost)
SERVER_URI=localhost

MINIO_BUCKET_NAME=devlocal

# 유형자산 엑셀 업서트(S-213) preview 서명 키 - 32바이트 이상 무작위 값
# 생성: openssl rand -base64 32
SMART_ASSET_EXCEL_SIGNING_KEY=

# JWT 서명 시크릿 - Base64, 디코드 후 32바이트 이상
# 생성: openssl rand -base64 64
WINITECH_JWT_SECRET=

# API Gateway ↔ 내부 서비스 간 매직헤더 시크릿 - 32바이트 이상
# 생성: openssl rand -base64 48
WINITECH_API_GATEWAY_MAGIC_HEADER_SECRET=

# REST API 암복호화용 RSA 개인키 (PKCS8, Base64, DER)
# 생성: openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048 | openssl pkcs8 -topk8 -nocrypt -outform DER | base64 -w0
WINITECH_ENC_PRIVATE_KEY=
