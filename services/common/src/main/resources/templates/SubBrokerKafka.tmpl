package ${basePackage};

import com.fasterxml.jackson.databind.ObjectMapper;
import ${serviceInterfacePackage}.${name}Service;
import ${interfacePackage}.${name}Handler;
import ${dtoPackage}.${dtoName}RequestDto;
import lombok.RequiredArgsConstructor;
import org.springframework.kafka.annotation.KafkaListener;
import org.springframework.kafka.support.*;
import org.springframework.messaging.handler.annotation.*;
import com.fasterxml.jackson.core.JsonProcessingException;
import org.springframework.stereotype.Component;
import lombok.extern.slf4j.Slf4j;

@Component
@RequiredArgsConstructor
@Slf4j
public class ${name}HandlerImpl implements ${name}Handler {
    private final ObjectMapper objectMapper;
    private final ${name}Service service;

    @KafkaListener(
        topics = "${topic}",
        groupId = "${group}"
    )
    public void subscribe(
        @Payload String message,
        @Header(KafkaHeaders.RECEIVED_TOPIC) String topic,
        Acknowledgment ack
    ) {
		log.info("|  SV  | RECV    | TOPIC | {}", "${topic}");
        try {
            this.handle(message, topic);
        }catch (JsonProcessingException e){
            log.error("${description}: error={}", e.getMessage());
            // 에러 발생 시에도 커밋하여 무한 재시도 방지
            // 필요시 DLQ(Dead Letter Queue)로 전송하는 로직 추가 가능
            if (ack != null) {
                ack.acknowledge();
            }
        }
    }

    @Override
    public void handle(String message, String topic) throws JsonProcessingException {
        ${dtoName}RequestDto eventDto = objectMapper.readValue(message, ${dtoName}RequestDto.class);
        service.process(eventDto, topic);
    }
}
