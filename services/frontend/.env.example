#개발환경 : DEV
#운영 환경 : PROD
VITE_NODE_ENV=DEV
#암호화 여부 : 해당기능은 parameter로 넘어가는 데이터를 모두 암호화 합니다(get, post, put, patch, delete 모두 암호화 get에 주소로 넘어가는경우는 포함안됌)
# true : 암호화 사용
# false : 암호화 사용 안함
VITE_ENCRYPTION=false

; 비워두면 프론트와 같은 오리진(상대경로)으로 API를 호출하고, vite.config.ts의 server.proxy가
; /api 요청을 내부적으로 http://localhost:28099(api-gateway)로 대신 전달한다.
; - localhost든 LAN IP(폰)든 항상 "지금 접속한 그 주소"로만 요청하므로 IP를 직접 맞춰줄 필요가 없다.
; - 프론트를 https로 띄웠을 때 http인 api-gateway로의 요청이 mixed content로 막히는 것도 방지된다.
VITE_INTERNAL_URL=

; 운영 HTTPS 환경에서 HTTP presigned URL을 중계할 reverse proxy 경로입니다.
; 개발 환경은 Vite 전용 /s3-proxy를 사용하므로 비워 둡니다.
; 운영 배포 시 Gateway/Reverse Proxy에 동일 경로를 구성한 뒤 값을 지정해야 합니다.
VITE_S3_UPLOAD_PROXY_PREFIX=

# 카카오 로그인 테스트 전용: 실제 값은 git에서 제외되는 .env.local에 입력합니다.
# 접속 주소와 동일한 프로토콜/호스트/포트를 지정하고 마지막 /는 제외합니다.
# Redirect URI 등록 예: http://localhost:5173/__kakao-test/callback
# HTTPS 인증서가 있으면 https 주소를 사용합니다. VITE_ 접두사를 붙이지 마세요.
KAKAO_TEST_ENABLED=false
KAKAO_TEST_ORIGIN=http://localhost:5173
KAKAO_TEST_REST_API_KEY=
KAKAO_TEST_CLIENT_SECRET=

; 도커내부 API 게이트웨이를 직접 호출하고 싶을 때(프록시 미사용):
; VITE_INTERNAL_URL= //localhost:28099
; 로컬 API 게이트웨이 사용시
; VITE_INTERNAL_URL= //localhost:28099
; 로컬백엔드 사용시
; VITE_INTERNAL_URL= //localhost:8092
